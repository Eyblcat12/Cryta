NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://crypta:crypta_local_only@localhost:5432/crypta
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
CORS_ORIGIN=http://127.0.0.1:5173,http://127.0.0.1:5174
COOKIE_SECURE=false
SMTP_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@example.com
SMTP_PASSWORD=replace-with-smtp-password-or-app-password
SMTP_FROM=Crypta <no-reply@example.com>
CRYPTO_PROVIDER_MODE=MOCK
CRYPTO_PROVIDER_URL=
CRYPTO_PROVIDER_TOKEN=
CRYPTO_PROVIDER_TIMEOUT_MS=15000
