# Operator configuration for the first Admin on a newly provisioned database.
# Paths are absolute inside the operator process or its container.
DATABASE_URL_FILE=
BOOTSTRAP_DATABASE_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_DEPARTMENT_CODE=
BOOTSTRAP_DEPARTMENT_NAME=
BOOTSTRAP_ADMIN_PASSWORD_FILE=

# Optional NOLOGIN owner assumed by the separate migrator LOGIN.
# DATABASE_MIGRATION_OWNER_ROLE=
# Optional public CA bundle. Set before starting Node.
# NODE_EXTRA_CA_CERTS=
