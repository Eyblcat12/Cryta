# Set release images to the approved immutable registry digests before use.
CRYPTA_BACKEND_IMAGE=
CRYPTA_FRONTEND_IMAGE=
CRYPTA_PROXY_PORT=18080
APP_ORIGIN=
APP_TIME_ZONE=Asia/Ho_Chi_Minh
CRYPTO_PROVIDER_URL=
CRYPTO_PROVIDER_SCOPE=
CRYPTO_PROVIDER_TIMEOUT_MS=15000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_FROM=
OPERATIONS_MONITOR_TOKEN_SHA256=

# Absolute paths on the deployment host. Each file contains one secret.
CRYPTA_DATABASE_URL_SECRET=
CRYPTA_JWT_ACCESS_SECRET=
CRYPTA_PROVIDER_TOKEN_SECRET=
CRYPTA_SMTP_PASSWORD_SECRET=
CRYPTA_ACCOUNT_ACTIONS_SECRET=
