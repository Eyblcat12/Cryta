POSTGRES_DB=crypta
POSTGRES_USER=crypta
POSTGRES_PASSWORD=CHANGE_ME_GENERATED_BY_START_SCRIPT
JWT_ACCESS_SECRET=CHANGE_ME_GENERATED_BY_START_SCRIPT
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
APP_PORT=8080
APP_ORIGIN=http://localhost:8080
COOKIE_SECURE=false

# Email thật: dùng SMTP credential/SMTP API key của nhà cung cấp.
SMTP_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@example.com
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=Crypta <no-reply@example.com>

# MOCK chi danh cho demo/local. Dung HTTP de noi KMS/HSM/CA adapter that.
CRYPTO_PROVIDER_MODE=MOCK
CRYPTO_PROVIDER_URL=
CRYPTO_PROVIDER_TOKEN=
CRYPTO_PROVIDER_TIMEOUT_MS=15000
