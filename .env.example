POSTGRES_DB=crypta
POSTGRES_USER=crypta
POSTGRES_PASSWORD=CHANGE_ME_GENERATED_BY_START_SCRIPT
# Local/demo only. Restricted runtime: run npm run migrate separately, then validate.
DATABASE_MIGRATION_MODE=apply
JWT_ACCESS_SECRET=CHANGE_ME_GENERATED_BY_START_SCRIPT
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
APP_PORT=8080
APP_ORIGIN=http://localhost:8080
APP_URL=http://localhost:8080
APP_TIME_ZONE=Asia/Ho_Chi_Minh
COOKIE_SECURE=false
# Optional. SHA-256 of a dedicated random 64-character lowercase hex monitor token.
OPERATIONS_MONITOR_TOKEN_SHA256=

# Email thật: dùng SMTP credential/SMTP API key của nhà cung cấp.
SMTP_ENABLED=false
ACCOUNT_ACTIONS_ENABLED=false
# Generate a dedicated 32-byte hex key before enabling invitations and password reset.
ACCOUNT_ACTION_KEY=
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# false uses required STARTTLS for remote/authenticated SMTP. Use true for implicit TLS.
SMTP_SECURE=false
SMTP_USER=no-reply@example.com
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=Crypta <no-reply@example.com>

# MOCK chi danh cho demo/local. Dung HTTP de noi KMS/HSM/CA adapter that.
CRYPTO_PROVIDER_MODE=MOCK
CRYPTO_PROVIDER_URL=
CRYPTO_PROVIDER_TOKEN=
# Stable non-secret provider account/environment identifier in HTTP mode.
CRYPTO_PROVIDER_SCOPE=
CRYPTO_PROVIDER_TIMEOUT_MS=15000
